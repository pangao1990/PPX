{
  "name": "ppx",
  "private": true,
  "version": "6.0.0",
  "description": "PPX：基于 pywebview、PyInstaller 和任意 Web 前端的跨平台桌面应用框架。",
  "author": "潘高 <pangao1990@qq.com>",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "init": "pnpm install && node ppx/tooling/scripts/python.mjs -m pip install -e ppx/packages/ppx-py && node ppx/tooling/scripts/python.mjs -m ppx_py.cli doctor",
    "clean": "node ppx/tooling/scripts/clean.mjs",
    "start": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli dev",
    "doctor": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli doctor",
    "update:check": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli update --check",
    "update:dry-run": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli update --dry-run",
    "update": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli update",
    "test": "run-s test:python test:js test:frontend",
    "test:python": "node ppx/tooling/scripts/python.mjs -m unittest discover -s ppx/tooling/tests -v",
    "test:js": "pnpm --dir ppx/packages/ppx-js test",
    "test:frontend": "pnpm -C gui run build",
    "check": "run-s doctor test check:release",
    "check:release": "node ppx/tooling/scripts/python.mjs ppx/tooling/scripts/check_release.py",
    "pre": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli build --console",
    "build": "node ppx/tooling/scripts/python.mjs -m ppx_py.cli build",
    "verify:installer": "node ppx/tooling/scripts/python.mjs ppx/tooling/scripts/check_installer.py"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3"
  }
}
